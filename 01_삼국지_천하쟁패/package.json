{
  "name": "samgukji-strategy",
  "productName": "삼국지 천하쟁패",
  "private": true,
  "version": "0.6.2",
  "description": "삼국지연의 기반 전략 시뮬레이션",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,app \"vite --port 5173 --strictPort\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:web": "vite",
    "build": "tsc && vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis",
    "mobile:sync": "npm run build && cap sync",
    "android:apk": "node scripts/mobile-build.mjs apk",
    "android:aab": "node scripts/mobile-build.mjs aab",
    "android:open": "cap open android",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "test": "vitest run",
    "typecheck": "tsc",
    "validate-data": "tsx scripts/validate-data.ts",
    "simulate": "tsx scripts/simulate.ts",
    "tempo": "tsx scripts/tempo.ts",
    "icon": "electron scripts/make-icon.cjs"
  },
  "build": {
    "appId": "local.samgukji.strategy",
    "productName": "삼국지 천하쟁패",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "삼국지 천하쟁패"
    }
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/screen-orientation": "^8.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.160.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@fontsource/ibm-plex-sans-kr": "^5.3.0",
    "@fontsource/noto-serif-kr": "^5.3.1",
    "@fontsource/song-myung": "^5.3.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "0.160.0",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.2.5",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5",
    "wait-on": "^8.0.5"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
